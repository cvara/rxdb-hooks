{
	"extends": "./tsconfig",
	"compilerOptions": {
		"target": "ES2019",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["jest", "node"],
		"lib": ["ES2019", "DOM"],
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true
	},
	"include": ["src", "tests"]
}
